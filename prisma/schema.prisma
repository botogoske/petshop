// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String?
  role      Role      @default(EMPLOYEE)
  active    Boolean   @default(true)
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  accounts  Account[]
  sessions  Session[]
}

enum Role {
  ADMIN
  EMPLOYEE
}

model Veterinarian {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String
  crmv         String        @unique
  specialty    String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  vaccines     Vaccine[]
}

model Tutor {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  cpf       String   @unique
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pets      Pet[]
}

model Pet {
  id           String        @id @default(cuid())
  name         String
  species      String
  breed        String?
  birthDate    DateTime?
  weight       Float?
  color        String?
  tutorId      String
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tutor        Tutor         @relation(fields: [tutorId], references: [id])
  appointments Appointment[]
  vaccines     Vaccine[]
  groomings    Grooming[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  category    String
  brand       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Appointment {
  id             String            @id @default(cuid())
  petId          String
  veterinarianId String
  date           DateTime
  reason         String
  notes          String?
  status         AppointmentStatus @default(SCHEDULED)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  pet            Pet               @relation(fields: [petId], references: [id])
  veterinarian   Veterinarian      @relation(fields: [veterinarianId], references: [id])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Vaccine {
  id             String       @id @default(cuid())
  petId          String
  veterinarianId String
  name           String
  date           DateTime
  nextDoseDate   DateTime?
  lot            String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  pet            Pet          @relation(fields: [petId], references: [id])
  veterinarian   Veterinarian @relation(fields: [veterinarianId], references: [id])
}

model Grooming {
  id          String         @id @default(cuid())
  petId       String
  date        DateTime
  serviceType GroomingType
  price       Float?
  notes       String?
  status      GroomingStatus @default(SCHEDULED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  pet         Pet            @relation(fields: [petId], references: [id])
}

enum GroomingType {
  BATH
  GROOMING
  BATH_AND_GROOMING
}

enum GroomingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
